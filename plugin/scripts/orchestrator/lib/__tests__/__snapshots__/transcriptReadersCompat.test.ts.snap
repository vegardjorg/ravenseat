exports[`askBundle.transcriptTail > text, tool lines and the handback in order; an empty handback is a tool line; other rows are left out 1`] = `
"assistant (2026-11-16 10:00): hello
- tool Read: a/b.txt
- tool REPL
- tool SubagentHandback
handback (2026-11-16 10:00): report
assistant: no time"
`;

